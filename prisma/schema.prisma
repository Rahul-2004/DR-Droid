generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Provider {
  OPENAI
  ANTHROPIC
  KIMI
  GEMINI
  OPENAI_COMPATIBLE
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum CreditReason {
  PURCHASE
  COUPON
  RESEARCH_REFUND
  RESEARCH_DEBIT
  ADMIN_ADJUSTMENT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ToolStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id               String          @id @db.Uuid
  email            String?         @unique
  displayName      String?
  avatarUrl        String?
  couponRedeemedAt DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  creditAccount    CreditAccount?
  providerKeys     ProviderKey[]
  conversations    Conversation[]
  payments         Payment[]
  usageRecords     UsageRecord[]
  reports          Report[]
  researchCaches   ResearchCache[]
}

model CreditAccount {
  id           String              @id @default(cuid())
  userId       String              @unique @db.Uuid
  balance      Int                 @default(0)
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
}

model CreditTransaction {
  id           String        @id @default(cuid())
  accountId    String
  delta        Int
  balanceAfter Int
  reason       CreditReason
  reference    String?       @unique
  metadata     Json?
  createdAt    DateTime      @default(now())
  account      CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

model ProviderKey {
  id             String          @id @default(cuid())
  userId         String          @db.Uuid
  provider       Provider
  label          String
  endpoint       String
  encryptedKey   String
  keyHint        String
  defaultModel   String
  pricing        Json
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  researchCaches ResearchCache[]

  @@unique([userId, label])
}

model Conversation {
  id              String             @id @default(cuid())
  userId          String             @db.Uuid
  providerKeyId   String?
  title           String             @default("New research")
  status          ConversationStatus @default(ACTIVE)
  totalCost       Decimal            @default(0) @db.Decimal(12, 8)
  creditsConsumed Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerKey     ProviderKey?       @relation(fields: [providerKeyId], references: [id], onDelete: SetNull)
  messages        Message[]
  usageRecords    UsageRecord[]
  toolCalls       ToolCall[]
  reports         Report[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String       @db.Text
  citations      Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ToolCall {
  id             String       @id @default(cuid())
  conversationId String
  name           String
  input          Json
  output         Json?
  status         ToolStatus   @default(RUNNING)
  startedAt      DateTime     @default(now())
  completedAt    DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id                String       @id @default(cuid())
  userId            String       @db.Uuid
  conversationId    String
  provider          String
  model             String
  inputTokens       Int          @default(0)
  outputTokens      Int          @default(0)
  cachedInputTokens Int          @default(0)
  reasoningTokens   Int          @default(0)
  toolCalls         Int          @default(0)
  cacheHit          Boolean      @default(false)
  cacheSavings      Decimal      @default(0) @db.Decimal(12, 8)
  cost              Decimal      @db.Decimal(12, 8)
  createdAt         DateTime     @default(now())
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Report {
  id             String       @id @default(cuid())
  userId         String       @db.Uuid
  conversationId String
  title          String
  content        String       @db.Text
  storagePath    String?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Payment {
  id                      String        @id @default(cuid())
  userId                  String        @db.Uuid
  stripeCheckoutSessionId String        @unique
  stripePaymentIntentId   String?       @unique
  amountCents             Int
  credits                 Int
  status                  PaymentStatus @default(PENDING)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResearchCache {
  id                String      @id @default(cuid())
  cacheKey          String      @unique
  userId            String      @db.Uuid
  providerKeyId     String
  model             String
  content           String      @db.Text
  citations         Json
  inputTokens       Int
  outputTokens      Int
  cachedInputTokens Int
  reasoningTokens   Int
  cost              Decimal     @db.Decimal(12, 8)
  expiresAt         DateTime
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerKey       ProviderKey @relation(fields: [providerKeyId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model ApiRateLimit {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
